datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(cuid())
  phone              String    @unique
  passwordHash       String
  role               String    // ADMIN, SUPPLIER, CUSTOMER
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplier     Supplier?
  customer     Customer?
}

model State {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  isActive  Boolean    @default(true)
  districts District[]
}

model District {
  id                   String                @id @default(cuid())
  stateId              String
  code                 String                @unique
  name                 String
  isActive             Boolean               @default(true)
  state                State                 @relation(fields: [stateId], references: [id])
  suppliers            Supplier[]
  serviceAreas         SupplierServiceArea[]
  customerAddresses    CustomerAddress[]
  orders               Order[]
}

model Category {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  hindiName      String?
  sortOrder      Int             @default(0)
  iconUrl        String?
  masterProducts MasterProduct[]
}

model Brand {
  id             String          @id @default(cuid())
  name           String          @unique
  logoUrl        String?
  masterProducts MasterProduct[]
}

model MasterProduct {
  id               String            @id @default(cuid())
  categoryId       String
  brandId          String?
  name             String
  description      String?
  defaultUnit      String            // BAG, KG, TONNE, CFT, PIECE
  specifications   String?           // JSON stringified specifications
  imageUrl         String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id])
  brand            Brand?            @relation(fields: [brandId], references: [id])
  supplierProducts SupplierProduct[]
}

model Supplier {
  id               String                @id @default(cuid())
  userId           String                @unique
  businessName     String
  ownerName        String
  phone            String
  address          String
  districtId       String
  gstin            String?
  logoUrl          String?
  description      String?
  status           String                @default("ACTIVE") // PENDING_APPROVAL, ACTIVE, SUSPENDED, REJECTED
  rating           Float                 @default(5.0)
  totalOrdersCount Int                   @default(0)
  isVerified       Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user             User                  @relation(fields: [userId], references: [id])
  district         District              @relation(fields: [districtId], references: [id])
  serviceAreas     SupplierServiceArea[]
  products         SupplierProduct[]
  orders           Order[]
  paymentRecords   PaymentRecord[]
  customerLedgers  CustomerLedger[]
  vehicles         SupplierVehicle[]
}

model SupplierServiceArea {
  id         String   @id @default(cuid())
  supplierId String
  districtId String
  isActive   Boolean  @default(true)

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  district   District @relation(fields: [districtId], references: [id])

  @@unique([supplierId, districtId])
}

model SupplierProduct {
  id                String        @id @default(cuid())
  supplierId        String
  masterProductId   String
  sellingPrice      Float
  unit              String
  stockQuantity     Float
  minOrderQty       Float         @default(1)
  deliveryCharge    Float         @default(0)
  isAvailable       Boolean       @default(true)
  lowStockThreshold Float         @default(10)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  supplier          Supplier      @relation(fields: [supplierId], references: [id])
  masterProduct     MasterProduct @relation(fields: [masterProductId], references: [id])
  orderItems        OrderItem[]

  @@unique([supplierId, masterProductId])
}

model Customer {
  id                String            @id @default(cuid())
  userId            String            @unique
  fullName          String
  phone             String
  defaultDistrictId String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id])
  addresses         CustomerAddress[]
  orders            Order[]
  paymentRecords    PaymentRecord[]
  ledgers           CustomerLedger[]
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  districtId   String
  addressLine  String
  landmark     String?
  pincode      String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id])
  district     District @relation(fields: [districtId], references: [id])
}

model Order {
  id                   String          @id @default(cuid())
  orderNumber          String          @unique
  customerId           String
  supplierId           String
  districtId           String
  totalMaterialAmount  Float
  deliveryCharge       Float           @default(0)
  finalTotal           Float
  amountPaid           Float           @default(0)
  balancePending       Float           @default(0)
  status               String          @default("PENDING_APPROVAL")
  paymentStatus        String          @default("PENDING")
  rejectionReason      String?
  deliveryAddress      String
  landmark             String?
  pincode              String?
  deliveryInstructions String?
  siteContactPhone     String
  driverName           String?
  driverPhone          String?
  vehicleNumber        String?
  deliveryChallanNo    String?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  customer             Customer        @relation(fields: [customerId], references: [id])
  supplier             Supplier        @relation(fields: [supplierId], references: [id])
  district             District        @relation(fields: [districtId], references: [id])
  items                OrderItem[]
  paymentRecords       PaymentRecord[]
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  supplierProductId String
  masterProductName String
  unit              String
  quantity          Float
  unitPrice         Float
  totalPrice        Float

  order             Order           @relation(fields: [orderId], references: [id])
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id])
}

model PaymentRecord {
  id          String   @id @default(cuid())
  supplierId  String
  customerId  String
  orderId     String?
  amount      Float
  paymentMode String   // CASH, UPI_DIRECT, BANK_TRANSFER, CHEQUE, UDHAAR
  notes       String?
  recordedAt  DateTime @default(now())

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])
}

model CustomerLedger {
  id                 String    @id @default(cuid())
  supplierId         String
  customerId         String
  totalPurchased     Float     @default(0)
  totalPaid          Float     @default(0)
  outstandingBalance Float     @default(0)
  lastOrderDate      DateTime?
  lastPaymentDate    DateTime?

  supplier           Supplier  @relation(fields: [supplierId], references: [id])
  customer           Customer  @relation(fields: [customerId], references: [id])

  @@unique([supplierId, customerId])
}

model SupplierVehicle {
  id            String    @id @default(cuid())
  supplierId    String
  vehicleNumber String
  vehicleType   String    @default("TRACTOR_TROLLEY") // TRACTOR_TROLLEY, TIPPER_TRUCK, CHHOTA_HATHI, PICKUP_TRUCK
  driverName    String?
  driverPhone   String?
  capacityInfo  String?
  status        String    @default("AVAILABLE") // AVAILABLE, ON_TRIP, MAINTENANCE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplier      Supplier  @relation(fields: [supplierId], references: [id])
}

