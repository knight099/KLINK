# Local only. Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://klink:klink_test_only@localhost:5432/klink_dev
# Generate with: openssl rand -hex 32
JWT_SECRET=
NODE_ENV=development
PORT=4000
# Production: exact HTTPS frontend origins, comma separated, no wildcard.
ALLOWED_ORIGINS=https://klink-flame.vercel.app
# Set to 1 only behind the trusted Vercel ingress / a single controlled reverse proxy.
TRUST_PROXY=0
# Local demo seeding only. Never enable in a production environment.
ALLOW_DEMO_SEED=false
# Optional initial admin bootstrap; use a unique password, no sample accounts.
ADMIN_PHONE=
ADMIN_PASSWORD=
# Optional storage (only if the upload features are needed)
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=assets
